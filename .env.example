# =============================================================================
# LACEN MT — variáveis de ambiente (NÃO commitar .env com segredos)
# Padrão alinhado a Sentinela / Araras (SIS-Monitoramento) / TITAN / Vigidesastres
# Copie para .env e preencha. Valores aqui são placeholders.
# =============================================================================

# Pastas
LACEN_DATA_DIR=saida_pipeline
LACEN_RAW_DIR=.

# Integrações opcionais (mesmo ecossistema CIEVS/Vigilância)
# OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# Telegram — alerta teste + relatório CIEVS 2×/semana
#   python scripts/enviar_alerta_teste.py
#   python scripts/enviar_relatorio_cievs.py --dry-run
#   python scripts/enviar_relatorio_cievs.py --telegram --email --to menandesneto@gmail.com
# Chaves compatíveis com Sentinela/Araras/TITAN/ondas de calor
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=   # preferido (alias Araras/ondas)
# TELEGRAM_TOKEN=       # alias Sentinela/TITAN/SCRAPER
# TELEGRAM_CHAT_ID=
# TG_CHAT_ID=           # alias ondas de calor

# -----------------------------------------------------------------------------
# E-mail SMTP — aliases Sentinela / Araras / Vigidesastres / ALERTA Cuiabá
# Gmail: smtp.gmail.com:587 (STARTTLS) ou :465 (SSL)
# Relatório CIEVS: mesmo bloco (EMAIL_TO / SMTP_*). Agenda: terça e sexta.
# -----------------------------------------------------------------------------
# EMAIL_TO=menandesneto@gmail.com
# EMAIL_DESTINATARIO=          # alias Sentinela/TITAN
# ALERT_EMAIL_TO=              # alias Araras
# EMAIL_FROM=
# EMAIL_REMETENTE=             # alias Sentinela (remetente = usuário SMTP)
# SMTP_FROM=                   # alias Araras
# EMAIL_USER=
# EMAIL_SENHA=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASS=                   # alias ALERTA VIGIDESASTRES Cuiabá
# SMTP_HOST=smtp.gmail.com
# SMTP_SERVER=                 # alias Vigidesastres
# SMTP_PORT=587
# SMTP_SSL=0
# SMTP_FALLBACK_HOST=          # ex.: smtp.titan.email (Araras/Sentinela)
# SMTP_FALLBACK_PORT=465

# -----------------------------------------------------------------------------
# Data Warehouse estadual (padrão SISREG / Sentinela DW_*)
# -----------------------------------------------------------------------------
# DW_HOST=
# DW_PORT=1433
# DW_DATABASE=
# DW_USER=
# DW_PASSWORD=

# GAL / redes internas (preencher só se houver API/SMB oficial)
# GAL_BASE_URL=
# GAL_USER=
# GAL_PASSWORD=

# Streamlit
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Acesso institucional ao dashboard (opcional; sem isso o painel fica anônimo)
# LACEN_REQUIRE_AUTH=1
# LACEN_DASHBOARD_PASSWORD=troque-esta-senha
# LACEN_AUTH_USERS=cievs:senha1,lacen:senha2
# Preferível no Cloud: Secrets TOML — ver .streamlit/secrets.toml.example e STREAMLIT_CLOUD.md
