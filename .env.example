# =============================================================================
# LACEN MT — variáveis de ambiente (NÃO commitar .env com segredos)
# Padrão alinhado a SISREG / Sentinela / AESOP / TITAN / Araras (SIS-Monitoramento)
# / ondas de calor / Vigidesastres / Meningites
# Copie para .env e preencha. Valores aqui são placeholders.
# Merge típico: prioriza SISREG (DW/SISREG), AESOP/TITAN (IndicaSUS), Sentinela/Araras (SMTP/Telegram).
# =============================================================================

# Pastas
LACEN_DATA_DIR=saida_pipeline
LACEN_RAW_DIR=.

# -----------------------------------------------------------------------------
# Telegram — alerta + Radar LACEN / CIEVS (Sentinela / Araras / ondas / AESOP / SCRAPER)
#   python scripts/enviar_alerta_teste.py
#   python scripts/enviar_relatorio_cievs.py --telegram --email
# -----------------------------------------------------------------------------
# LACEN_ALERTA_NOME=Radar LACEN   # nome do produto no header Telegram/e-mail
# TELEGRAM_BOT_TOKEN=          # preferido (Araras/ondas)
# TELEGRAM_TOKEN=              # alias Sentinela/TITAN/AESOP/SCRAPER
# TELEGRAM_CHAT_ID=
# TG_CHAT_ID=                  # alias ondas de calor
# ALERT_TELEGRAM_ENABLED=true

# -----------------------------------------------------------------------------
# E-mail SMTP — Sentinela / Araras / AESOP / Vigidesastres Cuiabá
# Gmail: smtp.gmail.com:587 (STARTTLS) ou :465 (SSL)
# -----------------------------------------------------------------------------
# EMAIL_TO=
# EMAIL_DESTINATARIO=          # alias Sentinela/AESOP
# ALERT_EMAIL_TO=              # alias Araras
# EMAIL_FROM=
# EMAIL_REMETENTE=
# EMAIL_USER=
# EMAIL_SENHA=
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASS=                   # alias Vigidesastres Cuiabá
# SMTP_HOST=smtp.gmail.com
# SMTP_SERVER=                 # alias Vigidesastres
# SMTP_PORT=587
# SMTP_SSL=0
# SMTP_USE_TLS=true
# SMTP_FALLBACK_HOST=          # ex.: smtp.titan.email (Sentinela/Araras)
# SMTP_FALLBACK_PORT=465
# ALERT_EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# Data Warehouse estadual — mesmo host SISREG / AESOP / TITAN / Meningites
# ETL: python -m etl.run_etl_dw   |   rodar_etl_dw.bat
# Aliases: DW_* e DATAWAREHOUSE_* (lacen_dw.py / ml/mirror_dw.py)
# Sem VPN SES → falha clara; offline: --allow-local-fallback
# Agenda: etl/AGENDADOR.md
# -----------------------------------------------------------------------------
# DW_HOST=10.15.1.50
# DW_SERVER=                   # alias
# DW_PORT=1433
# DW_DATABASE=Datawarehouse
# DW_DB=                       # alias
# DW_USER=
# DW_PASSWORD=
# DW_DRIVER=ODBC Driver 18 for SQL Server
# DW_ODBC_DRIVER=
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# DW_SCHEMA=dbo
# DW_TRUST_CERT=yes
# DW_TRUST_SERVER_CERTIFICATE=yes
# DW_ENCRYPT=no
# DW_QUERY_TIMEOUT_SECONDS=120
# DATAWAREHOUSE_HOST=
# DATAWAREHOUSE_DATABASE=
# DATAWAREHOUSE_USER=
# DATAWAREHOUSE_PASSWORD=
# DATAWAREHOUSE_PORT=1433
# DATAWAREHOUSE_TRUST_CERT=yes
# DATAWAREHOUSE_ENCRYPT=no
# USE_SQLSERVER=true
# USE_DW_GAL=true
# USE_DW_SINAN=true
# USE_DW_SIM=true
# USE_DW_CNES=true
# USE_DW_INDICASUS=true
# USE_DW_SIH=true
# USE_DW_SIA=true
# USE_DW_SISREG=false
# USE_DW_SIVEP=false
# DATAWAREHOUSE_SERVER=        # alias DW_HOST
# DATAWAREHOUSE_USERNAME=      # alias DW_USER
# DATAWAREHOUSE_DB=            # alias DW_DATABASE
# DW_USERNAME=                 # alias DW_USER
# DW_DB=                       # alias DW_DATABASE
# DW_CLIENT=pyodbc
# DW_CONFIG_PATH=
# DW_ENV_FILE=

# -----------------------------------------------------------------------------
# IndicaSUS — AESOP / TITAN / SISREG (.env.example) / Araras / ondas de calor
# Host típico institucional (VPN). No DW não há view *INDICASUS*; proxy: INDICADORES*.
# -----------------------------------------------------------------------------
# INDICASUS_SGBD=mssqlserver
# INDICASUS_HOST=
# INDICASUS_SERVER=            # alias
# INDICASUS_PORT=1433
# INDICASUS_DATABASE=
# INDICASUS_DB=                # alias AESOP/TITAN_RUN
# INDICASUS_USER=
# INDICASUS_PASSWORD=
# INDICASUS_TRUST_CERT=yes
# INDICASUS_TRUST_SERVER_CERTIFICATE=yes
# INDICASUS_ENCRYPT=no
# INDICASUS_SCHEMA=dbo
# INDICASUS_DATE_FROM=2021-01-01
# INDICASUS_USE_DW_CREDENTIALS=false
# Preferir INDICASUS_USER/PASSWORD nativos (DW_* no host *.222 costuma falhar login).
# INDICASUS_ALLOW_CSV_FALLBACK=true
# USE_INDICASUS_OCCUPANCY_SCRIPT=false

# Extratos: python -m etl.run_fontes_adicionais  → staging_dw/indicasus_* + sisreg_*
# (também chamado por etl/dw_extract.run_extract; falha soft)

# -----------------------------------------------------------------------------
# SISREG — projeto irmão SISREG (SQL + paths locais + slots API)
# Nenhuma view *SISREG* no DW inventariado — conexão própria.
# Ping TCP opcional no etl/dw_extract (check_sisreg_tcp); falha NÃO bloqueia ETL/CIEVS.
# -----------------------------------------------------------------------------
# SISREG_HOST=
# SISREG_PORT=1433
# SISREG_DATABASE=
# SISREG_DB=                   # alias AESOP
# SISREG_USER=
# SISREG_PASSWORD=
# SISREG_TRUST_CERT=yes
# SISREG_ENCRYPT=no
# SISREG_BASE=
# SISREG_DB_DIR=
# SISREG_PARQUET=
# SISREG_OUT=
# SISREG_MEMORY_LIMIT=8GB
# SISREG_THREADS=4
# SISREG_SLOTS_API_URL=
# SISREG_SLOTS_API_TOKEN=

# -----------------------------------------------------------------------------
# SIH / internação — ondas de calor / Araras (proxy no DW: VW_INTERNACAO)
# Sem objeto *SIH*/*AIH* no catálogo; apontar tabela/view real.
# ETL grava vw_internacao_recent.* + sih_mun_cid_familia_agg.* (hepatite/TB/arbov).
# -----------------------------------------------------------------------------
# SIH_DW_SCHEMA=dbo
# SIH_DW_TABLE=VW_INTERNACAO
# USE_DW_SIH=true
# USE_DW_SIA=true
# USE_DW_SISREG=false

# -----------------------------------------------------------------------------
# GAL / clima / APIs opcionais
# -----------------------------------------------------------------------------
# GAL_BASE_URL=
# GAL_USER=
# GAL_PASSWORD=
# OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# LLM opcional — reescrita de parecer VE / assistente (NÃO inventa números)
#   python scripts/gerar_relatorio_ve.py --enviar
# Sem chave: usa só regras + conhecimento_ve/ (Guia MS curado).
# -----------------------------------------------------------------------------
# LACEN_LLM_API_KEY=
# OPENAI_API_KEY=              # alias
# LACEN_LLM_MODEL=gpt-4o-mini

# Streamlit
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Acesso institucional ao dashboard (opcional)
# LACEN_REQUIRE_AUTH=1
# LACEN_DASHBOARD_PASSWORD=troque-esta-senha
# LACEN_AUTH_USERS=cievs:senha1,lacen:senha2
