# Copie para secrets.toml (local) ou cole em Streamlit Cloud → Manage app → Secrets.
# NÃO commite secrets.toml com senhas reais.

# Força login mesmo sem senha configurada (útil para validar o gate):
# LACEN_REQUIRE_AUTH = "1"

# --- Opção A: senha compartilhada institucional ---
[auth]
password = "troque-esta-senha"

# --- Opção B: usuários nomeados (preferível na SES) ---
# [auth.users]
# cievs = "senha-cievs"
# lacen = "senha-lacen"
# vigidesastres = "senha-vigi"

# Admin (override de pasta de dados no painel)
# MODO_ADMIN = false
